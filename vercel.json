{
  "experimentalServices": {
    "backend": {
      "root": "backend",
      "routePrefix": "/_/backend",
      "framework": "express",
      "buildCommand": "npm install && npx prisma generate"
    },
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "vite",
      "buildCommand": "npm install && npm run build"
    }
  }
}
  