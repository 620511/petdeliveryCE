# ── Server ─────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── PostgreSQL (Prisma) ────────────────────────────────────────────
# postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL="postgresql://postgres:petdeliveryce2512A@localhost:5432/petdelivery"

# ── JWT ────────────────────────────────────────────────────────────
JWT_SECRET=troque_por_string_longa_e_aleatoria_minimo_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=outra_string_longa_e_aleatoria_minimo_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── Upload de arquivos ─────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ── E-mail (opcional — deixe em branco para desativar) ─────────────
# Para Gmail: gere uma "senha de app" em myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PetDelivery <noreply@petdelivery.com>"
