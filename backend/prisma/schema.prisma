// backend/prisma/schema.prisma
// FRETE DINÂMICO: lat/lng na Store + model DeliveryZone

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──────────────────────────────────────────────────────────

enum Role {
  admin
  store_owner
  customer
}

enum OrderStatus {
  pending
  confirmed
  preparing
  on_the_way
  delivered
  cancelled
}

enum PaymentMethod {
  pix
  credit_card
  debit_card
  cash
  mercadopago
}

enum PaymentStatus {
  pending
  approved
  rejected
  refunded
  not_applicable
}

enum PayoutMethod {
  mp_split
  manual
}

enum PayoutStatus {
  pending
  processing
  paid
  failed
}

// ── Models ─────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(customer)
  phone        String?
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  store         Store?
  orders        Order[]
  addresses     Address[]
  reviews       Review[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Category {
  id        String  @id @default(uuid())
  name      String
  emoji     String?
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  subcategories Subcategory[]
  products      Product[]

  @@map("categories")
}

model Subcategory {
  id         String @id @default(uuid())
  categoryId String @map("category_id")
  name       String
  sortOrder  Int    @default(0) @map("sort_order")

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("subcategories")
}

model Store {
  id              String   @id @default(uuid())
  ownerId         String   @unique @map("owner_id")
  name            String
  description     String?
  logoUrl         String?  @map("logo_url")
  address         String
  phone           String?
  isActive        Boolean  @default(false) @map("is_active")
  isOpen          Boolean  @default(false) @map("is_open")
  rating          Float    @default(0)
  reviewCount     Int      @default(0) @map("review_count")
  deliveryTimeMin Int      @default(30) @map("delivery_time_min")
  deliveryTimeMax Int      @default(60) @map("delivery_time_max")
  minOrderValue   Float    @default(0) @map("min_order_value")
  deliveryFee     Float    @default(8.9) @map("delivery_fee")  // fallback se não houver faixas

  // FRETE DINÂMICO: coordenadas GPS geocodificadas do endereço da loja
  lat             Float?   // latitude  (nullable — preenchido ao salvar perfil)
  lng             Float?   // longitude (nullable — preenchido ao salvar perfil)

  // FASE 3: Mercado Pago
  mpAccessToken   String?      @map("mp_access_token")
  mpUserId        String?      @map("mp_user_id")
  payoutMethod    PayoutMethod @default(manual) @map("payout_method")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products      Product[]
  orders        Order[]
  reviews       Review[]
  payouts       Payout[]
  deliveryZones DeliveryZone[] // FRETE DINÂMICO

  @@map("stores")
}

// FRETE DINÂMICO: faixas de entrega configuradas pelo lojista
model DeliveryZone {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  maxKm      Float    @map("max_km")       // km máximo desta faixa (ex: 3.0)
  fee        Float                          // taxa de entrega nesta faixa (ex: 5.00)
  freeAbove  Float?   @map("free_above")   // frete grátis se subtotal >= X (nullable)
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("delivery_zones")
}

model Product {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  categoryId    String?  @map("category_id")
  subcategoryId String?  @map("subcategory_id")
  name          String
  description   String?
  price         Float
  stock         Int      @default(0)
  emoji         String?
  imageUrl      String?  @map("image_url")
  badge         String?
  rating        Float    @default(0)
  reviewCount   Int      @default(0) @map("review_count")
  unit          String   @default("un")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id])
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id])
  orderItems  OrderItem[]

  @@map("products")
}

model Address {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  label        String   @default("Casa")
  street       String
  number       String?
  complement   String?
  neighborhood String?
  city         String
  state        String
  zipCode      String   @map("zip_code")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

model Order {
  id                  String        @id @default(uuid())
  customerId          String        @map("customer_id")
  storeId             String        @map("store_id")
  addressId           String?       @map("address_id")
  deliveryAddress     String?       @map("delivery_address")
  status              OrderStatus   @default(pending)
  paymentMethod       PaymentMethod @map("payment_method")
  subtotal            Float
  deliveryFee         Float         @default(0) @map("delivery_fee")
  total               Float
  platformFee         Float?        @map("platform_fee")
  storeNet            Float?        @map("store_net")
  paymentStatus       PaymentStatus @default(not_applicable) @map("payment_status")
  mpPaymentId         String?       @map("mp_payment_id")
  mpPreferenceId      String?       @map("mp_preference_id")
  mpCheckoutUrl       String?       @map("mp_checkout_url")
  notes               String?
  estimatedDeliveryAt DateTime?     @map("estimated_delivery_at")
  deliveredAt         DateTime?     @map("delivered_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  customer User       @relation(fields: [customerId], references: [id])
  store    Store      @relation(fields: [storeId], references: [id])
  address  Address?   @relation(fields: [addressId], references: [id])
  items    OrderItem[]
  review   Review?
  payout   Payout?

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String  @map("order_id")
  productId    String? @map("product_id")
  productName  String  @map("product_name")
  productEmoji String? @map("product_emoji")
  productPrice Float   @map("product_price")
  quantity     Int
  total        Float

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payout {
  id          String       @id @default(uuid())
  storeId     String       @map("store_id")
  orderId     String       @unique @map("order_id")
  amount      Float
  method      PayoutMethod
  status      PayoutStatus @default(pending)
  paidAt      DateTime?    @map("paid_at")
  receipt     String?
  adminNote   String?      @map("admin_note")
  mpPayoutId  String?      @map("mp_payout_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@map("payouts")
}

model Review {
  id         String   @id @default(uuid())
  orderId    String   @unique @map("order_id")
  customerId String   @map("customer_id")
  storeId    String   @map("store_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  order    Order @relation(fields: [orderId], references: [id])
  customer User  @relation(fields: [customerId], references: [id])
  store    Store @relation(fields: [storeId], references: [id])

  @@map("reviews")
}
